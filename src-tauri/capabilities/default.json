{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
    "description": "主窗口默认权限：HTTP 转发（收窄到具体 provider 域 + 本地 Ollama）、插件目录读写、文件对话框",
    "windows": ["main"],
    "permissions": [
        "core:default",
        {
            "identifier": "http:default",
            "allow": [
                { "url": "https://*/*" },
                { "url": "http://127.0.0.1:11434/*" },
                { "url": "http://localhost:11434/*" }
            ]
        },
        "fs:default",
        "fs:allow-appdata-read-recursive",
        "fs:allow-appdata-write-recursive",
        "fs:allow-mkdir",
        "fs:allow-read-dir",
        "fs:allow-read-text-file",
        "fs:allow-write-text-file",
        "fs:allow-remove",
        "fs:allow-exists",
        {
            "identifier": "fs:scope",
            "allow": [
                { "path": "$APPDATA/**" },
                { "path": "$HOME/**" },
                { "path": "$DOCUMENT/**" },
                { "path": "$RESOURCE/**" }
            ]
        },
        "dialog:default",
        "opener:default",
        {
            "identifier": "opener:allow-open-path",
            "allow": [{ "path": "$HOME/**" }]
        }
    ]
}
