{
  "version": 1,
  "name": "H4 自举演示：worktree 隔离建改查 + 宿主证据验收",
  "description": "第一轮低风险自举任务样例：在隔离 worktree 中创建 docs/self-dev-demo.md（dev.code.patch），查 git 状态/diff、采集宿主登记结果证据、确定性验收、宿主批准后清理 worktree。运行：npm run headless examples/self-dev-demo.workflow.json -- --dev-approve-cleanup dev-wt-demo --dev-acceptance-id acc-self-dev-demo-patch",
  "nodes": [
    {
      "id": "wt-create",
      "type": "dev.worktree.create",
      "label": "创建隔离工作区",
      "params": { "path": "dev-wt-demo" }
    },
    {
      "id": "code-patch",
      "type": "dev.code.patch",
      "label": "创建新文档",
      "params": {
        "orchestrationId": "self-dev-demo",
        "stageId": "patch",
        "worktreePath": "dev-wt-demo",
        "path": "docs/self-dev-demo.md",
        "patch": "--- /dev/null\n+++ b/docs/self-dev-demo.md\n@@ -0,0 +1,3 @@\n+# H4 自举演示\n+\n+由 dev.code.patch 在隔离 worktree 中创建（第一轮低风险自举任务）。\n"
      }
    },
    {
      "id": "git-status",
      "type": "dev.git.status",
      "label": "Git 状态",
      "params": {
        "orchestrationId": "self-dev-demo",
        "stageId": "patch",
        "worktreePath": "dev-wt-demo"
      }
    },
    {
      "id": "git-diff",
      "type": "dev.git.diff",
      "label": "Git Diff",
      "params": {
        "orchestrationId": "self-dev-demo",
        "stageId": "patch",
        "worktreePath": "dev-wt-demo",
        "baseRef": "HEAD"
      }
    },
    {
      "id": "evidence",
      "type": "dev.evidence.add",
      "label": "采集宿主证据",
      "params": {
        "orchestrationId": "self-dev-demo",
        "stageId": "patch",
        "worktreePath": "dev-wt-demo",
        "resultId": "code-patch-result"
      }
    },
    {
      "id": "accept",
      "type": "dev.accept",
      "label": "确定性验收",
      "params": {
        "orchestrationId": "self-dev-demo",
        "stageId": "patch",
        "worktreePath": "dev-wt-demo",
        "acceptanceId": "acc-self-dev-demo-patch",
        "rules": [{ "id": "diff-applied", "kind": "diff" }]
      }
    },
    {
      "id": "wt-cleanup",
      "type": "dev.worktree.cleanup",
      "label": "清理工作区（宿主批准+验收通过后）",
      "params": { "worktreePath": "dev-wt-demo" }
    }
  ],
  "edges": [
    { "id": "e1", "source": "wt-create", "sourceHandle": "path", "target": "code-patch", "targetHandle": "worktreePath", "data": { "kind": "data" } },
    { "id": "e2", "source": "code-patch", "sourceHandle": "resultId", "target": "evidence", "targetHandle": "resultId", "data": { "kind": "data" } },
    { "id": "e3", "source": "code-patch", "sourceHandle": "resultId", "target": "git-status", "targetHandle": "after", "data": { "kind": "data" } },
    { "id": "e4", "source": "git-status", "sourceHandle": "resultId", "target": "git-diff", "targetHandle": "after", "data": { "kind": "data" } },
    { "id": "e5", "source": "git-diff", "sourceHandle": "resultId", "target": "evidence", "targetHandle": "after", "data": { "kind": "data" } },
    { "id": "e6", "source": "evidence", "sourceHandle": "evidenceId", "target": "accept", "targetHandle": "after", "data": { "kind": "data" } },
    { "id": "e7", "source": "accept", "sourceHandle": "passed", "target": "wt-cleanup", "targetHandle": "after", "data": { "kind": "data" } }
  ]
}
